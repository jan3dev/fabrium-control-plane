# Copy this file to `.env` and replace every <placeholder>.
# Docker Compose and `cargo run` read `.env`.

# Required. Comma-separated <tenant>:<sha256-hex of the API key>.
# A tenant name uses only a-z, 0-9, and -. Put the hash here, never the key.
API_KEYS=stage:<sha256-hex>,prod:<sha256-hex>

# Required. The base URL that new VMs use to redeem their token. It must be an https URL.
PUBLIC_URL=https://<host>

# Used by compose.caddy.yaml. The host name that Caddy serves and gets a certificate for.
CP_HOST=<host>

# AWS credentials of the control plane. Temporary credentials expire:
# put new ones here and recreate the container.
# Leave out AWS_SESSION_TOKEN if the key is not temporary.
AWS_ACCESS_KEY_ID=<access key id>
AWS_SECRET_ACCESS_KEY=<secret access key>
AWS_SESSION_TOKEN=<session token>

# Optional. These lines show the defaults.
# AWS_REGION=us-east-2
# AMI_NAME=ubuntu-24.04-jan3-dev-env-v3
# INSTANCE_TYPES=t3a.medium,t3a.large,t3.medium,t3.large,m6a.large,c6a.large,r6a.large
# DEFAULT_INSTANCE_TYPE=t3a.medium
# SECURITY_GROUP=jan3-dev-env-ssh
# KEY_NAME=fabrium-vms
# RUST_LOG=info
