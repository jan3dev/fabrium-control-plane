# Copy this file to .env and edit it.
#
# Required. Comma-separated <name>:<sha256-hex> pairs. Store the SHA-256 hash of
# each key, never the key itself.
#   KEY=$(openssl rand -hex 32)
#   printf %s "$KEY" | sha256sum        # macOS: shasum -a 256
API_KEYS=zooid:<sha256-hex>

# Log filter (default: info).
RUST_LOG=info

# Local runs only. The Docker image sets both values, so leave them unset there.
# BIND_ADDR=127.0.0.1:8080
# DATABASE_URL=sqlite://data/control-plane.db
